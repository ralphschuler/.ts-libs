{
  "name": "@ralphschuler/ts-error",
  "version": "1.0.0",
  "author": {
    "name": "Ralph Schuler",
    "email": "ralph.schuler@nyphon.de"
  },
  "bugs": {
    "url": "https://github.com/ralphschuler/.ts-libs/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.2.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://nyphon.de/.ts-libs/en/modules/ts-error/",
  "keywords": [
    "helpers",
    "library",
    "tools",
    "typescript",
    "utils"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "repository": "https://github.com/ralphschuler/.ts-libs",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist node_modules docs",
    "docs": "typedoc --entryPointStrategy resolve --json docs/docs.json --plugin typedoc-plugin-missing-exports --plugin typedoc-plugin-mdn-links --readme ./README.md src/index.ts",
    "format": "prettier src/",
    "format:fix": "prettier --write src/",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "lint:report": "eslint --output-file eslint_report.json --format json src/ --ext .ts",
    "prepublish": "yarn build",
    "publish": "yarn npm publish",
    "start": "tsx src/index.ts",
    "test": "node ../../.github/scripts/run-tests.mjs ."
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
